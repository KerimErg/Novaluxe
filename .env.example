# Copiez ce fichier en .env.local (en local) et renseignez les valeurs.
# Sur Netlify : Site configuration → Environment variables.
#
# MODE LISTE D'ATTENTE (config.checkoutEnabled = false, réglage actuel) :
# aucune variable n'est nécessaire. Les réservations passent par Netlify Forms.
#
# MODE PAIEMENT (config.checkoutEnabled = true) : renseignez les variables ci-dessous.

# Clé secrète Stripe (Developers → API keys). sk_test_... en test, sk_live_... en production.
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (whsec_...).
# En local : affiché par `stripe listen`. En production : dans Developers → Webhooks → votre endpoint.
STRIPE_WEBHOOK_SECRET=

# Clé API Resend (resend.com → API Keys) pour recevoir l'e-mail « nouvelle commande ».
RESEND_API_KEY=

# Expéditeur de l'e-mail de notification. Sans domaine vérifié chez Resend, gardez onboarding@resend.dev
# (Resend n'enverra alors qu'à l'adresse de votre compte Resend).
RESEND_FROM="Canarinho Store <onboarding@resend.dev>"

# Adresse publique du site, sans / final (utilisée pour les retours depuis Stripe).
# Facultatif : si vide, l'adresse de la requête est utilisée.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
